# Server port (Render sets this automatically in production)
PORT=5000
NODE_ENV=development

# Optional — overrides the default log level (debug in dev, info in
# production/staging, silent in tests). One of: trace, debug, info, warn,
# error, fatal, silent.
LOG_LEVEL=

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/gracia-fab

# JWT signing secret for auth tokens
JWT_SECRET=replace-with-a-long-random-string

# URL of the deployed client, used for CORS
FRONTEND_URL=https://gracia-fab.vercel.app

# Redis connection string, used by BullMQ background job queues
REDIS_URL=redis://localhost:6379

# Google OAuth (social login)
GOOGLE_CLIENT_ID=

# Monnify (payments). From the Monnify dashboard → Developers. The secret key
# also verifies webhook signatures. MONNIFY_BASE_URL is optional: it defaults
# to live (https://api.monnify.com) when NODE_ENV=production and to sandbox
# (https://sandbox.monnify.com) otherwise. Webhook URL to register in the
# dashboard: <your API URL>/api/webhooks/monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=

# AI providers — Gemini is tried first, Groq is the fallback
GEMINI_API_KEY=
GROQ_API_KEY=

# Outbound email (Resend — sends over HTTPS, unlike SMTP this works on
# PaaS hosts like Render that block outbound SMTP ports). Get a key at
# resend.com. RESEND_FROM_EMAIL is optional — omit it to send from
# onboarding@resend.dev, which works without verifying a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
